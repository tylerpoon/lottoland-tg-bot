# Copy to .env and fill in. Load with e.g. `set -a; . .env; set +a`.

# Telegram bot token from @BotFather.
LOTTO_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to run admin commands
# (/setup, /startdraft, /setlock, /runscore_now).
LOTTO_ADMINS=

# Where to keep the SQLite file. Default: ./lotto.db
LOTTO_DB_PATH=lotto.db

# IANA timezone for the daily job and roster lock window. Default: America/New_York
LOTTO_TZ=America/New_York

# Hour (local TZ, 24h) at which the daily scrape+score+post job runs. Default: 9
LOTTO_DAILY_HOUR=9
